# Base URL of the live Spring Boot backend.
# Leave unset to use the built-in default (https://apexgrid-backend-ejej.onrender.com).
VITE_API_BASE_URL=https://apexgrid-backend-ejej.onrender.com

# Same-origin proxy prefix used as an automatic fallback when a direct
# cross-origin call is blocked. Empty string = same origin (/api/*).
VITE_PROXY_API_BASE=
